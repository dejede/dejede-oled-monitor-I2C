config global 'global'
	option theme 'normal'
	option contrast '255'
	option flip '0'
	option transition 'slide_left'
	option transition_ms '600'

config scene 'main'
	option enable '1'
	option duration '60'
	option layout 'classic'
	option marquee '1'
	option text '>> DEJEDE : 085236578999 - PHOTO & VIDEO SERVICES <<'
	option speed '40'

config scene 'weather'
	option enable '1'
	option duration '20'
	option layout 'classic'
	option city 'Jakarta'
	option lat ''
	option lon ''
	option unit 'c'
	option refresh '15'

config scene 'ticker'
	option enable '1'
	option duration '15'
	option style 'cyber'
	option text1 'DEJEDE'
	option text2 'PHOTO & VIDEO'
	option text3 '085236578999'
	option speed '50'
	option glitch '1'
